# lost the superjane password? set this, restart, read the new one from stdout, then unset it
# RESET_SUPERUSER=1

export JANEHQ_UI_PORT=8086


# stdout logging: info (default) or debug (every web call + each ingested report as JSON)
# JANEHQ_DEBUG_LEVEL=info

# JaneHQ ingest port - where agents send their data to
export JANEHQ_INGEST_PORT=25900 

# days of metric history to keep (default 360); older rows are deleted
# export JANEHQ_METRICS_RETENTION=360

export JANEHQ_DEBUG_LEVEL=debug 

# for Google OAUTH authentication
export JANEHQ_BASE_URL=http://localhost:8086
export JANEHQ_GOOGLE_CLIENT_ID=8xxxxxx.apps.googleusercontent.com
export JANEHQ_GOOGLE_CLIENT_SECRET=xxxxxxxxx

# optional: only allow this Workspace domain
export JANEHQ_GOOGLE_DOMAIN=company.com