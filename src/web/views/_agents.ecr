<% if agents.empty? %>
  <% if group.default %>
    <p class="muted">No agents have reported yet. Point a Jane agent's <code>[hq]</code> at this server on port <%= config.ingest_port %>.</p>
  <% else %>
    <p class="muted">No reporting hosts in <%= HTML.escape(group.name) %> yet.
      <a href="/host-groups/<%= group.id %>/edit">Edit the group</a> to add some.</p>
  <% end %>
<% else %>
  <%# .table-scroll keeps a wide table inside its own scroll box — without it %>
  <%# the page itself widens and the topbar nav slides off screen. %>
  <div class="table-scroll">
  <table class="agents">
    <thead>
      <tr>
        <th>Status</th>
        <th>Host</th>
        <th>Alerts</th>
        <th class="col-cpu">CPU</th>
        <th class="col-mem">Memory</th>
        <th class="col-load">Load</th>
        <th class="col-seen">Last seen</th>
        <th class="glance-col">Glance</th>
      </tr>
    </thead>
    <tbody>
      <% agents.each do |a| %>
        <% stale = a.stale?(stale_after, now) %>
        <tr class="<%= a.alert_count > 0 ? "row-alert" : "row-ok" %><%= stale ? " row-stale" : "" %>">
          <td>
            <% if stale %>
              <span class="badge badge-stale">offline</span>
            <% elsif a.alert_count > 0 %>
              <span class="badge badge-alert">alert</span>
            <% else %>
              <span class="badge badge-ok">ok</span>
            <% end %>
          </td>
          <td><a href="/agent/<%= HTML.escape(a.hostname) %>"><%= HTML.escape(a.hostname) %></a>
            <div class="muted small"><%= HTML.escape(a.os) %></div>
          </td>
          <td class="num">
            <% if a.alert_count > 0 %>
              <span class="alert-count"><%= a.alert_count %></span> / <%= a.check_count %>
            <% else %>
              <span class="muted">0</span> / <%= a.check_count %>
            <% end %>
          </td>
          <td class="num col-cpu"><%= HTML.escape(a.cpu_usage) %></td>
          <td class="num col-mem"><%= HTML.escape(a.memory_usage) %></td>
          <td class="num col-load"><%= HTML.escape(a.load_avg) %></td>
          <td class="muted small col-seen"><%= (now - a.last_seen) %>s ago</td>
          <td class="glance-col">
            <button type="button" class="glance-btn"
                    aria-label="Glance at <%= HTML.escape(a.hostname) %>"
                    title="Glance"
                    hx-get="/partials/glance/<%= URI.encode_path_segment(a.hostname) %>"
                    hx-target="#glance-body"
                    hx-swap="innerHTML"
                    aria-haspopup="dialog">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <span>Glance</span>
            </button>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
<% end %>
