<% stale = agent.stale?(stale_after, now) %>
<div class="page-head">
  <p><a href="/">&larr; All servers</a></p>
  <h1><%= HTML.escape(agent.hostname) %>
    <% if stale %>
      <span class="badge badge-stale">offline</span>
    <% elsif agent.alert_count > 0 %>
      <span class="badge badge-alert"><%= agent.alert_count %> alert(s)</span>
    <% else %>
      <span class="badge badge-ok">ok</span>
    <% end %>
  </h1>
  <p class="subtitle"><%= HTML.escape(agent.os) %> — last seen <%= JaneHQ.ago(now - agent.last_seen) %> ago (Jane <%= HTML.escape(agent.jane_version) %>)</p>
</div>

<section>
  <h2>Checks</h2>
  <div class="table-scroll">
  <table class="checks" id="checks-table">
    <thead>
      <tr>
        <% %w(Status Check Tag Current Threshold Message).each do |h| %>
          <% if %w(Status Check Tag).includes?(h) %>
            <th><button type="button" class="group-th" data-col="<%= h %>" title="Group by <%= h.downcase %>"><%= h %> <span class="grp" aria-hidden="true">&#9776;</span></button></th>
          <% else %>
            <th data-col="<%= h %>"><%= h %></th>
          <% end %>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% checks.each do |c| %>
        <tr class="<%= c.alert? ? "row-alert" : "row-ok" %>">
          <td>
            <% if c.alert? %>
              <span class="badge badge-alert">alert</span>
            <% else %>
              <span class="badge badge-ok">ok</span>
            <% end %>
          </td>
          <td><%= HTML.escape(c.name) %></td>
          <td><%= HTML.escape((Array(String).from_json(c.tags) rescue [] of String).join(", ")) %></td>
          <td class="num"><%= HTML.escape(c.current) %></td>
          <td class="num"><%= HTML.escape(c.threshold) %></td>
          <td><%= HTML.escape(c.message) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
</section>

<section>
  <h2>Metrics</h2>
  <div class="table-scroll">
  <table class="metrics">
    <tbody>
      <tr><th>Kernel</th><td><%= HTML.escape(agent.kernel) %></td></tr>
      <tr><th>Uptime</th><td><%= HTML.escape(agent.uptime) %></td></tr>
      <tr><th>CPU</th><td><%= HTML.escape(agent.cpu_model) %> (<%= agent.cpu_cores %> cores)</td></tr>
      <tr><th>CPU usage</th><td><%= HTML.escape(agent.cpu_usage) %></td></tr>
      <tr><th>Load average</th><td><%= HTML.escape(agent.load_avg) %></td></tr>
      <tr><th>Memory</th><td><%= HTML.escape(agent.used_memory) %> / <%= HTML.escape(agent.total_memory) %> used (<%= HTML.escape(agent.memory_usage) %>)</td></tr>
      <tr><th>Free memory</th><td><%= HTML.escape(agent.free_memory) %></td></tr>
    </tbody>
  </table>
  </div>
</section>

<script src="/checks.js?v=<%= JaneHQ::ASSET_VERSION %>"></script>
