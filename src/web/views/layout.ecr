<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>JaneHQ</title>
  <link rel="stylesheet" href="/app.css?v=<%= JaneHQ::ASSET_VERSION %>">
  <script src="/htmx.min.js"></script>
  <script src="/nav.js?v=<%= JaneHQ::ASSET_VERSION %>" defer></script>
</head>
<body>
  <% path = env.request.path %>
  <header class="topbar">
    <%# The logo is inlined (JaneHQ::LOGO_SVG) so its paths can inherit the %>
    <%# topbar's colour; aria-label names the link, as there is no link text. %>
    <a class="brand" href="/" aria-label="JaneHQ"><%= JaneHQ::LOGO_SVG %></a>
    <nav class="topnav">
      <details class="menu">
        <summary>Admin</summary>
        <ul class="menu-items">
          <li><a href="/" class="<%= path == "/" || path.starts_with?("/agent/") ? "active" : "" %>">Hosts</a></li>
          <li><a href="/host-groups" class="<%= path == "/host-groups" ? "active" : "" %>">Host Groups</a></li>
          <li><a href="/users" class="<%= path == "/users" ? "active" : "" %>">Users</a></li>
          <li><a href="/alert-groups" class="<%= path.starts_with?("/alert-groups") ? "active" : "" %>">Alerts</a></li>
        </ul>
      </details>
      <form class="logout" method="post" action="/logout">
        <button type="submit">Log out</button>
      </form>
    </nav>
  </header>
  <main class="container">
    <%= content %>
  </main>
</body>
</html>
